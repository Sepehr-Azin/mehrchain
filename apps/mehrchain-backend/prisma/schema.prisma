// File: apps/mehrchain-backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Pillar categories for commitments
enum Category {
  health
  growth
  community
  environment
}

enum ChainStatus {
  ACTIVE
  RESTING
  FADING
  COMPLETED
  DORMANT
  DISCONNECTED
}

enum ChainInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// User model for persistent authentication and identity
model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  username                  String    @unique
  name                      String?
  passwordHash              String
  role                      String    @default("USER")
  timeZone                  String    @default("UTC") // Fixed at signup; legacy accounts keep UTC
  isEmailVerified           Boolean   @default(false)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  metadata                  Json? // Extensible metadata for future gamification & preferences

  commitments Commitment[]
  meroProgress MeroProgress?
  meroColors MeroColor[]
  meroDays MeroCollectionDay[]
  meroPartners MeroAcceptedPartner[] @relation("MeroPartnerOwner")
  meroPartnerOf MeroAcceptedPartner[] @relation("MeroPartnerAccount")

  // Relations for Chain
  userChains    ChainConnection[] @relation("UserChains")
  partnerChains ChainConnection[] @relation("PartnerChains")
  chainInvites  ChainInvite[]     @relation("SenderInvites")
  acceptedInvites ChainInvite[]   @relation("AcceptedInvites")
  sentHearts    ChainHeart[]
  disconnectReceipts ChainDisconnectReceipt[] @relation("DisconnectRecipient")
  partnerDisconnectReceipts ChainDisconnectReceipt[] @relation("DisconnectPartner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@map("users")
}

// Private permanent reward state, independent of habit/connection lifetimes.
model MeroProgress {
  userId                 String    @id
  unlockedAt             DateTime?
  unlockedDayKey         String?
  collectionDays         Int       @default(0)
  acceptedPartners       Int       @default(0)
  selectedSlot           Int       @default(0) // 0 is the always-available default glow
  preferencesInitialized Boolean   @default(false)
  hasSentSupport         Boolean   @default(false)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mero_progress")
}

model MeroColor {
  userId String
  slot   Int
  name   String
  hex    String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, slot])
  @@map("mero_colors")
}

model MeroCollectionDay {
  userId String
  dayKey String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dayKey])
  @@map("mero_collection_days")
}

// Identity deduplication only. Deleting a partner removes the reference, while
// the owner's permanent acceptedPartners counter remains earned.
model MeroAcceptedPartner {
  userId    String
  partnerId String
  user      User @relation("MeroPartnerOwner", fields: [userId], references: [id], onDelete: Cascade)
  partner   User @relation("MeroPartnerAccount", fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([userId, partnerId])
  @@index([partnerId])
  @@map("mero_accepted_partners")
}

// Core habit commitment model
model Commitment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title                 String
  category              Category
  why                   String?
  totalDays             Int
  currentDay            Int       @default(0)
  currentStreak         Int       @default(0)
  consecutiveMissedDays Int       @default(0)
  startDate             DateTime  @default(now())
  lastCompletedDate     DateTime?
  inactivityAnchorAt    DateTime? // Fresh grace date after restore or continuing a reached goal
  reminderTime          String?
  isPublic              Boolean   @default(false)
  isArchived            Boolean   @default(false)

  rippleEffects String[] // Potential connected chain effects
  history       String[] // Legacy date strings
  logs          CommitmentLog[] // Granular completion logs

  // Relations for Chain
  userChains    ChainConnection[] @relation("UserChainCommitment")
  partnerChains ChainConnection[] @relation("PartnerChainCommitment")
  chainInvites  ChainInvite[]     @relation("SenderCommitmentInvites")
  acceptedInvites ChainInvite[]   @relation("AcceptedCommitmentInvites")
  receivedHearts ChainHeart[]

  metadata Json? // Extensible metadata for future modules

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("commitments")
}

// Granular completion log for activity tracking & future analytics
model CommitmentLog {
  id           String     @id @default(uuid())
  commitmentId String
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())
  dayKey      String? // Null only for surplus historical duplicates; never for new completions
  timeZone    String   @default("UTC")
  note        String?
  metadata    Json? // Future metrics (e.g. mood, energy level)

  @@index([commitmentId])
  @@unique([commitmentId, dayKey])
  @@map("commitment_logs")
}

// Two-way active chain connection between users
model ChainConnection {
  id String @id @default(uuid())
  generationId String @default(uuid())

  userId    String
  partnerId String

  userCommitmentId    String
  partnerCommitmentId String

  status                ChainStatus @default(ACTIVE)
  consecutiveMissedDays Int         @default(0)
  lastPartnerActivityAt DateTime?
  lastNudgeSentAt       DateTime?
  heartSent             Boolean     @default(false)
  heartSentAt           DateTime?

  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  user              User       @relation("UserChains", fields: [userId], references: [id], onDelete: Cascade)
  partner           User       @relation("PartnerChains", fields: [partnerId], references: [id], onDelete: Cascade)
  userCommitment    Commitment @relation("UserChainCommitment", fields: [userCommitmentId], references: [id], onDelete: Cascade)
  partnerCommitment Commitment @relation("PartnerChainCommitment", fields: [partnerCommitmentId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId, userCommitmentId])
  @@map("chain_connections")
}

// A private, durable receipt independent of connection/habit deletion or reuse.
// Deleting either participant removes the receipt and any personal explanation.
model ChainDisconnectReceipt {
  id                    String @id @default(uuid())
  recipientId           String
  partnerId             String
  recipientConnectionId String
  generationId          String
  recipientHabitTitle   String
  reason                String
  note                  String?
  createdAt             DateTime @default(now())
  readAt                DateTime?

  recipient User @relation("DisconnectRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  partner   User @relation("DisconnectPartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([recipientConnectionId, generationId], map: "chain_disconnect_receipts_connection_generation_key")
  @@index([recipientId, readAt, createdAt])
  @@map("chain_disconnect_receipts")
}

// Durable daily allowance, independent of the number/lifecycle of connection rows.
// Connection heartSent/heartSentAt retain visibility and are cleared on detach.
model ChainHeart {
  senderId              String
  recipientCommitmentId String
  dayKey                String
  sentAt                DateTime @default(now())

  sender     User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipient  Commitment @relation(fields: [recipientCommitmentId], references: [id], onDelete: Cascade)

  @@id([senderId, recipientCommitmentId, dayKey])
  @@index([recipientCommitmentId, dayKey])
  @@map("chain_hearts")
}

// Invite flow replacing old direct requests
model ChainInvite {
  id String @id @default(uuid())

  senderId           String
  senderCommitmentId String

  inviteCode String            @unique @default(uuid())
  status     ChainInviteStatus @default(PENDING)

  acceptedById         String?
  acceptedCommitmentId String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  sender           User       @relation("SenderInvites", fields: [senderId], references: [id], onDelete: Cascade)
  senderCommitment Commitment @relation("SenderCommitmentInvites", fields: [senderCommitmentId], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("AcceptedInvites", fields: [acceptedById], references: [id], onDelete: Cascade)
  acceptedCommitment Commitment? @relation("AcceptedCommitmentInvites", fields: [acceptedCommitmentId], references: [id], onDelete: Cascade)

  @@map("chain_invites")
}
